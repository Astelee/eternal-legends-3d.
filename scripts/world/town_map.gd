func _ready() -> void:
	map_id = "town"
	title = "Vila Inicial"
	world_limit = Rect2(0, 0, TILE * 40, TILE * 30)
	spawn_points = {"default": Vector2(328, 272), "dungeon": Vector2(328, 416)}
	var tile_set := _build_tile_set()
	var ground := _make_layer("Ground", tile_set)
	var objects := _make_layer("Objects", tile_set)
	_paint(ground, GROUND)
	_paint(objects, OBJECTS)
	_spawn_npcs()
	_spawn_portal()


func _build_tile_set() -> TileSet:
	var tile_set := TileSet.new()
	tile_set.tile_size = Vector2i(TILE, TILE)
	tile_set.add_physics_layer()
	var source := TileSetAtlasSource.new()
	source.texture = TOWN_TEXTURE
	source.texture_region_size = Vector2i(TILE, TILE)
	tile_set.add_source(source, 0)
	var rows := int(TOWN_TEXTURE.get_height() / TILE)
	for row in rows:
		for col in COLS:
			source.create_tile(Vector2i(col, row))
	var half := TILE / 2.0
	var square := PackedVector2Array([
		Vector2(-half, -half), Vector2(half, -half), Vector2(half, half), Vector2(-half, half)
	])
	for id in BLOCKED:
		var data := source.get_tile_data(Vector2i(id % COLS, id / COLS), 0)
		data.add_collision_polygon(0)
		data.set_collision_polygon_points(0, 0, square)
	return tile_set


func _make_layer(layer_name: String, tile_set: TileSet) -> TileMapLayer:
	var layer := TileMapLayer.new()
	layer.name = layer_name
	layer.tile_set = tile_set
	add_child(layer)
	return layer


func _paint(layer: TileMapLayer, rows: Array) -> void:
	for y in rows.size():
		var row: Array = rows[y]
		for x in row.size():
			var id: int = row[x]
			if id >= 0:
				layer.set_cell(Vector2i(x, y), 0, Vector2i(id % COLS, id / COLS))


func _spawn_npcs() -> void:
	for data in NPCS:
		var cell: Vector2i = data["tile"]
		var npc := Npc.new()
		npc.texture = CHARACTER_TEXTURE
		npc.frame = data["frame"]
		npc.position = Vector2(cell.x * TILE + 8, cell.y * TILE + 16)
		add_child(npc)


# Porta da masmorra no fim da estrada, ao sul.
func _spawn_portal() -> void:
	var portal := Portal.new()
	portal.texture = CHARACTER_TEXTURE
	portal.frame = 45
	portal.target = "dungeon"
	portal.caption = "Masmorra"
	portal.position = Vector2(20 * TILE + 8, 27 * TILE + 16)
	portal.used.connect(func(t: String) -> void: portal_used.emit(t, map_id))
	add_child(portal)